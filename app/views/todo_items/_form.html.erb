<% todo_item ||= nil %>
<% todo_record = todo_item || (defined?(TodoItem) ? TodoItem.new : nil) %>
<% goal_record = local_assigns[:goal] || todo_record&.try(:subgoal)&.try(:goal) %>
<% subgoals = Array(goal_record&.try(:subgoals)).select { |subgoal| subgoal.try(:persisted?) } %>
<% selected_subgoal = todo_record&.try(:subgoal) || subgoals.first %>
<% form_url = if todo_record&.try(:persisted?) && respond_to?(:todo_item_path)
  todo_item_path(todo_record)
elsif selected_subgoal&.try(:persisted?) && respond_to?(:subgoal_todo_items_path)
  subgoal_todo_items_path(selected_subgoal)
else
  "#"
end %>

<% if todo_record %>
  <%= form_with model: todo_record, url: form_url, method: (todo_record.persisted? ? :patch : :post), class: "goal-map-form", data: { turbo_frame: "todo_item_form" } do |form| %>
    <%= form.label :title, "今日やったこと" %>
    <%= form.text_field :title, placeholder: "15分だけ手をつけた", autocomplete: "off" %>

    <% unless todo_record.persisted? %>
      <label for="todo-subgoal-select">つながるサブ目標</label>
      <select id="todo-subgoal-select" class="goal-map-form__select" data-goal-map-target="subgoalSelect" data-action="change->goal-map#changeTodoSubgoal">
        <% subgoals.each do |subgoal| %>
          <option value="<%= subgoal_todo_items_path(subgoal) if respond_to?(:subgoal_todo_items_path) %>" <%= "selected" if subgoal == selected_subgoal %>>
            <%= subgoal.title %>
          </option>
        <% end %>
      </select>
    <% end %>

    <%= form.label :memo, "メモ" %>
    <%= form.text_field :memo, placeholder: "気づいたことを一言", autocomplete: "off" %>

    <% if todo_record.persisted? %>
      <label class="goal-map-form__check">
        <%= form.check_box :completed_at, { checked: todo_record.completed?, data: { goal_map_target: "completedCheckbox", action: "goal-map#setCompletedAt" } }, Time.current.iso8601, "" %>
        <span>完了にする</span>
      </label>
    <% end %>

    <%= form.submit todo_record.persisted? ? "更新" : "一歩を追加" %>
  <% end %>
<% else %>
  <form class="goal-map-form">
    <label>今日やったこと</label>
    <input type="text" placeholder="15分だけ手をつけた">
    <label>つながるサブ目標</label>
    <select class="goal-map-form__select">
      <option>サブゴールを追加してください</option>
    </select>
    <label>メモ</label>
    <input type="text" placeholder="気づいたことを一言">
    <button type="button">一歩を追加</button>
  </form>
<% end %>
