<% content_for :title, "ログイン" %>

<section class="auth-page">
  <div class="auth-panel">
    <div class="auth-panel__header">
      <p>Welcome back</p>
      <h1>ログイン</h1>
    </div>

    <%= form_with url: login_path, class: "goal-map-form auth-form" do |form| %>
      <%= form.label :email, "メールアドレス" %>
      <%= form.email_field :email, autocomplete: "email" %>

      <%= form.label :password, "パスワード" %>
      <%= form.password_field :password, autocomplete: "current-password" %>

      <%= form.submit "ログイン" %>
    <% end %>

    <%= link_to "アカウント作成", new_user_path, class: "auth-panel__link" %>
  </div>
</section>
