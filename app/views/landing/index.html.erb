<% content_for :title, "ミチシルベ | 長期学習のロードマップアプリ" %>
<% content_for :body_class, "landing-page landing-page--single" %>

<div class="lp-page lp-page--single">
  <%= image_tag "landing/hero-road.png", alt: "", class: "lp-single__background", aria: { hidden: true } %>

  <section class="lp-single" aria-labelledby="lp-hero-title">
    <div class="lp-single__hero">
      <div class="lp-single__copy">
        <p class="lp-eyebrow">長期学習のためのロードマップアプリ</p>
        <h1 id="lp-hero-title" class="lp-title">今日の学習を、未来まで続く道のりに変える。</h1>
        <p class="lp-lead">
          価値観・長期ゴール・サブゴール・クエストを一枚のマップでつなぎ、不安や焦りを減らしながら前進を実感するためのロードマップアプリ。
        </p>
        <div class="lp-actions" aria-label="主要な操作">
          <%= link_to "マップを作成する", new_user_path, class: "lp-button lp-button--primary" %>
          <%= link_to "ログイン", login_path, class: "lp-button lp-button--secondary" %>
        </div>
      </div>

    </div>

    <div id="concept" class="lp-single__concept" aria-label="頑張っているのに進んでいる実感が持てない課題と、Todoを増やすより進んでいる方向を見失わない考え方">
      <%= image_tag "landing/lp-concept-band-reference.png",
        alt: "頑張っているのに、進んでいる実感が持てない。Todoを増やすより、進んでいる方向を見失わない。",
        class: "lp-single__concept-image" %>
    </div>
  </section>
</div>
