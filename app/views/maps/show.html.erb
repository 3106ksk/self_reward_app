<% content_for :title, "Goal Map" %>

<div class="goal-map-page" data-controller="goal-map">
  <%= render "maps/panel",
    goal: defined?(@goal) ? @goal : nil,
    subgoal: defined?(@subgoal) ? @subgoal : nil,
    todo_item: defined?(@todo_item) ? @todo_item : nil %>

  <%= turbo_frame_tag "goal-map-board", class: "goal-map-board-frame" do %>
    <%= render "maps/map",
      goal: defined?(@goal) ? @goal : nil,
      subgoals: defined?(@subgoals) ? @subgoals : [],
      todo_items: defined?(@todo_items) ? @todo_items : [] %>
  <% end %>
</div>
