<% goal_record = local_assigns[:goal] %>

<% if goal_record %>
  <%= form_with model: goal_record, url: goal_path(goal_record), method: :patch, class: "goal-map-form", data: { turbo_frame: "goal_form" } do |form| %>
    <% if goal_record.errors[:title].any? %>
      <div class="goal-map-form__errors">
        <% goal_record.errors.full_messages_for(:title).each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form.label :title, "長期ゴール" %>
    <%= form.text_field :title, placeholder: "例: 3か月後に小さなRailsアプリを公開する", autocomplete: "off" %>

    <%= form.label :description, "長期ゴールの説明、理想状態" %>
    <%= form.text_field :description, placeholder: "例: どんな状態になればゴール達成か", autocomplete: "off" %>

    <%= form.hidden_field :value_statement %>
    <%= form.submit "長期ゴールを更新" %>
  <% end %>
<% else %>
  <form class="goal-map-form">
    <label>長期ゴール</label>
    <input type="text" placeholder="例: 3か月後に小さなRailsアプリを公開する">
    <label>長期ゴールの説明、理想状態</label>
    <input type="text" placeholder="例: どんな状態になればゴール達成か">
    <button type="button">長期ゴールを更新</button>
  </form>
<% end %>
